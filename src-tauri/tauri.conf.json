{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "citroam",
  "version": "0.1.0",
  "identifier": "cn.jiachen.notes",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "citroam",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "backgroundColor": "#F4F6EA"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../agent/citroam.cordis.patch.yml": "agent/citroam.cordis.patch.yml",
      "../agent/citroam-tool.mjs": "agent/citroam-tool.mjs"
    }
  }
}
